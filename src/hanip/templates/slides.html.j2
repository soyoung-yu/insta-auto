<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<style>
@font-face { font-family: "Pretendard"; font-weight: 400; src: url("{{ fonts }}/Pretendard-Regular.woff2") format("woff2"); }
@font-face { font-family: "Pretendard"; font-weight: 700; src: url("{{ fonts }}/Pretendard-Bold.woff2") format("woff2"); }
@font-face { font-family: "Pretendard"; font-weight: 800; src: url("{{ fonts }}/Pretendard-ExtraBold.woff2") format("woff2"); }
@font-face { font-family: "Pretendard"; font-weight: 900; src: url("{{ fonts }}/Pretendard-Black.woff2") format("woff2"); }
@font-face { font-family: "D2Coding"; font-weight: 400; src: url("{{ fonts }}/D2Coding.ttf") format("truetype"); }
@font-face { font-family: "D2Coding"; font-weight: 700; src: url("{{ fonts }}/D2Coding-Bold.ttf") format("truetype"); }

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 1080px; height: 1350px; overflow: hidden; }
body {
  position: relative;
  background: {{ c.bg }};
  background-image: radial-gradient({{ c.dots }} 1px, transparent 1px);
  background-size: 16px 16px;
  color: {{ c.text }};
  font-family: "Pretendard", sans-serif;
  word-break: keep-all;
}
.tag { position: absolute; left: 72px; top: 56px; font: 700 40px "D2Coding", monospace; color: {{ c.accent }}; letter-spacing: 2px; }
.pg { position: absolute; right: 72px; top: 60px; font: 700 34px "D2Coding", monospace; color: {{ c.muted }}; }
.foot { position: absolute; left: 72px; right: 72px; bottom: 56px; display: flex; justify-content: space-between; font: 700 34px "D2Coding", monospace; }
.foot .handle { color: {{ c.muted }}; }
.foot .swipe { color: {{ c.accent }}; }

.content { position: absolute; left: 90px; right: 90px; top: 150px; bottom: 70px; display: flex; flex-direction: column; }
.content.center { justify-content: center; }
.content.top { justify-content: flex-start; }
.content > * { flex: 0 0 auto; }

/* paper: one long strip across slides 2–10. Straight edge where it starts (2) and ends (10), torn in between */
.paper { background: {{ c.paper }}; color: {{ c.text }}; box-shadow: inset 0 0 0 4px {{ c.edge }}; padding: 64px 60px; }
.paper.edge-bottom { padding-bottom: 88px; -webkit-mask: radial-gradient(circle 16px at 50% 100%, transparent 98%, #000) bottom / 40px 100% repeat-x; }
.paper.edge-both { padding-top: 88px; padding-bottom: 88px;
  -webkit-mask: radial-gradient(circle 16px at 50% 0, transparent 98%, #000) top / 40px 51% repeat-x,
                radial-gradient(circle 16px at 50% 100%, transparent 98%, #000) bottom / 40px 51% repeat-x; }
.paper.edge-top { padding-top: 88px; -webkit-mask: radial-gradient(circle 16px at 50% 0, transparent 98%, #000) top / 40px 100% repeat-x; }
.paper.caution { box-shadow: inset 0 0 0 6px {{ c.warn_border }}; }

/* highlighter question title */
h2.hl { display: inline; font: 900 62px/1.3 "Pretendard", sans-serif;
  background: linear-gradient(transparent 58%, {{ c.marker }} 58%, {{ c.marker }} 90%, transparent 90%); }
.head { margin-bottom: 44px; }

/* concept colors: a = first compared thing, b = second, o = neither */
.ca { background: {{ c.a_bg }}; color: {{ c.a_fg }}; padding: 0 8px; border-radius: 6px; }
.cb { background: {{ c.b_bg }}; color: {{ c.b_fg }}; padding: 0 8px; border-radius: 6px; }

.line { display: flex; align-items: baseline; font: 400 40px/1.9 "D2Coding", monospace; }
.line .label { flex: 0 0 auto; white-space: nowrap; }
.line .leader { flex: 1 1 24px; min-width: 24px; border-bottom: 4px dotted {{ c.text }}; opacity: .3; margin: 0 14px; transform: translateY(-10px); }
.line .value { flex: 0 1 auto; min-width: 0; white-space: nowrap; overflow: hidden; }
.def { font: 800 58px/1.45 "Pretendard", sans-serif; max-height: 260px; overflow: hidden; margin-bottom: 36px; }

table.cmp { width: 100%; border-collapse: collapse; table-layout: fixed; }
.cmp th { font: 800 42px "Pretendard", sans-serif; padding: 16px 6px; white-space: nowrap; overflow: hidden; border-radius: 16px 16px 0 0; }
.cmp col.k { width: 22%; }
.cmp td { font: 600 36px/1.3 "Pretendard", sans-serif; text-align: center; padding: 22px 6px; border-top: 3px dashed {{ c.edge }}; white-space: nowrap; overflow: hidden; }
.cmp td.k { font: 700 30px "D2Coding", monospace; color: {{ c.muted }}; }
.cmp .cap td { font: 400 28px "Pretendard", sans-serif; color: {{ c.muted }}; border-top: 0; padding-top: 0; }
.conclusion { margin-top: 40px; text-align: center; font: 800 48px "Pretendard", sans-serif; white-space: nowrap; overflow: hidden; }

.myth { margin-bottom: 34px; }
.myth .w, .myth .r { display: flex; gap: 20px; align-items: baseline; font: 700 42px/1.4 "Pretendard", sans-serif; }
.myth .w { color: {{ c.muted }}; text-decoration: line-through; text-decoration-thickness: 3px; }
.myth .r { margin-top: 10px; }
.myth .mk { flex: 0 0 52px; text-decoration: none; display: inline-block; font-weight: 900; }
.myth .w .mk { color: {{ c.muted }}; }
.myth .r .mk { color: {{ c.accent }}; }

/* example = relationship: [src] —action→ [dst] */
.ex { margin-bottom: 30px; }
.exname { font: 700 30px "D2Coding", monospace; color: {{ c.muted }}; margin-bottom: 10px; }
.rel, .solo { display: flex; align-items: center; gap: 0; }
.rel .src, .rel .dst, .solo .src { flex: 0 0 auto; font: 800 38px "Pretendard", sans-serif; padding: 14px 22px; border-radius: 16px; white-space: nowrap; }
.src { background: {{ c.a_bg }}; color: {{ c.a_fg }}; }
.dst { background: {{ c.b_bg }}; color: {{ c.b_fg }}; }
.act { flex: 1 1 auto; min-width: 120px; position: relative; text-align: center; padding: 0 14px 18px; }
.act em { display: block; font: 600 30px "Pretendard", sans-serif; font-style: normal; color: {{ c.text }}; white-space: nowrap; overflow: hidden; }
.act i { position: absolute; left: 14px; right: 26px; bottom: 6px; border-bottom: 4px solid {{ c.muted }}; }
.act i::after { content: ""; position: absolute; right: -18px; top: -10px; border: 12px solid transparent; border-left: 18px solid {{ c.muted }}; }
.solo .note { font: 500 34px "Pretendard", sans-serif; margin-left: 24px; white-space: nowrap; overflow: hidden; }

.bubble { position: relative; font: 600 40px/1.4 "Pretendard", sans-serif; padding: 26px 36px; border-radius: 40px; background: {{ c.bubble }}; margin-bottom: 26px; overflow: hidden; }
.bubble::before { content: "✓"; color: {{ c.accent }}; font-weight: 900; margin-right: 18px; }
.bubble.r { margin-left: 70px; }

.flow { display: flex; flex-direction: column; align-items: center; }
.node span { display: block; white-space: nowrap; overflow: hidden; }
.node { width: 86%; text-align: center; font: 700 40px/1.3 "Pretendard", sans-serif; padding: 20px 24px; border-radius: 22px; white-space: nowrap; overflow: hidden; }
.node b { font-family: "D2Coding", monospace; margin-right: 16px; }
.node.na { background: {{ c.a_bg }}; color: {{ c.a_fg }}; }
.node.nb { background: {{ c.b_bg }}; color: {{ c.b_fg }}; }
.node.no { background: {{ c.o_bg }}; color: {{ c.o_fg }}; }
.arrow { color: {{ c.muted }}; font: 700 40px/1.2 "Pretendard", sans-serif; }

.news { border-left: 10px solid {{ c.accent }}; padding: 6px 0 6px 30px; margin-bottom: 40px; }
.news .t { font: 800 42px/1.3 "Pretendard", sans-serif; max-height: 112px; overflow: hidden; }
.news .s { font: 700 28px "D2Coding", monospace; color: {{ c.muted }}; margin-top: 8px; }
.news .y { font: 500 34px/1.4 "Pretendard", sans-serif; margin-top: 10px; max-height: 96px; overflow: hidden; }
.news .y::before { content: "→ "; color: {{ c.accent }}; font-weight: 800; }
.fallback { font: 600 46px/1.5 "Pretendard", sans-serif; max-height: 280px; overflow: hidden; }

.warn { display: flex; gap: 28px; align-items: flex-start; margin-bottom: 36px; }
.warn .ic { flex: 0 0 66px; height: 66px; border-radius: 50%; background: #ffd166; color: #1b1430; text-align: center; font: 900 38px/66px "Pretendard", sans-serif; }
.warn .tx { min-width: 0; }
.warn b { display: block; font: 800 44px/1.3 "Pretendard", sans-serif; white-space: nowrap; overflow: hidden; }
.warn span { display: block; font: 400 34px/1.4 "Pretendard", sans-serif; color: {{ c.muted }}; margin-top: 6px; white-space: nowrap; overflow: hidden; }

.total { display: flex; justify-content: space-between; gap: 20px; font: 700 42px "D2Coding", monospace; }
.total .v { white-space: nowrap; overflow: hidden; min-width: 0; }
.hr { border-top: 4px dashed {{ c.text }}; opacity: .3; margin: 26px 0; }

.cover-wrap { position: absolute; left: 130px; top: 190px; width: 820px; }
.char-cover { width: 820px; display: block; }
.mouth { position: absolute; left: 128px; top: 307px; width: 564px; height: 577px; padding: 44px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; overflow: hidden; }
.mouth .title { font: 900 78px/1.2 "Pretendard", sans-serif; color: #fff; max-height: 290px; overflow: hidden; }
.mouth .subtitle { font: 600 40px/1.35 "Pretendard", sans-serif; color: #ffadc9; margin-top: 26px; max-height: 110px; overflow: hidden; }

.signoff { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 46px; gap: 24px; }
.signoff .big { font: 900 50px "Pretendard", sans-serif; white-space: nowrap; }
.signoff .big .heart { color: #ff5d8f; }
.signoff .small { font: 400 34px "Pretendard", sans-serif; color: {{ c.muted }}; margin-top: 12px; }
.signoff .handle { font: 700 36px "D2Coding", monospace; color: {{ c.accent }}; margin-top: 18px; }
.char-ending { width: 330px; flex: 0 0 auto; display: block; }

.filler { position: absolute; left: 50%; bottom: 80px; width: 560px; transform: translateX(-50%); }
.char-pose { width: 100%; display: block; }
</style>
</head>
<body>
<div class="tag">{{ tag }}</div>
{% if n > 1 %}<div class="pg">{{ n }} / {{ total_slides }}</div>{% endif %}

{% macro head(title) %}<div class="head"><h2 class="hl">{{ title }}</h2></div>{% endmacro %}

{% if n == 1 %}
  <div class="cover-wrap">
    {{ cover_svg }}
    <div class="mouth fit">
      <div class="title fit" data-autofit="44">{{ post.cover.title }}</div>
      <div class="subtitle fit" data-autofit="30">{{ post.cover.subtitle }}</div>
    </div>
  </div>
  <div class="foot"><span class="handle">{{ handle }}</span><span class="swipe">SWIPE &gt;</span></div>

{% else %}
<div class="content {{ align }}">

{% if n == 2 %}
  <div class="paper edge-bottom">
    {{ head("그래서 뭔데?") }}
    <div class="def fit">{{ concepts(post.definition.definition) }}</div>
    {% for r in post.definition.rows %}<div class="line"><span class="label">{{ r.label }}</span><i class="leader"></i><span class="value fit">{{ r.value }}</span></div>{% endfor %}
  </div>

{% elif n == 3 %}
  {% set cp = post.compare %}
  <div class="paper edge-both">
    {{ head("뭐가 달라?") }}
    <table class="cmp">
      <colgroup><col class="k"><col><col></colgroup>
      <tr><th></th><th class="ca">{{ cp.a.name }}</th><th class="cb">{{ cp.b.name }}</th></tr>
      <tr class="cap"><td></td><td class="fit">{{ cp.a.caption }}</td><td class="fit">{{ cp.b.caption }}</td></tr>
      {% for ra in cp.a.rows %}{% set rb = cp.b.rows[loop.index0] if loop.index0 < cp.b.rows|length else none %}
      <tr><td class="k">{{ ra.label }}</td><td class="fit">{{ ra.value }}</td><td class="fit">{{ rb.value if rb else "" }}</td></tr>
      {% endfor %}
    </table>
    <div class="conclusion fit">{{ concepts(cp.conclusion) }}</div>
  </div>

{% elif n == 4 %}
  <div class="paper edge-both">
    {{ head("헷갈리지 마!") }}
    {% for m in post.confusion.items %}
    <div class="myth">
      <div class="w"><span class="mk">✗</span><span class="fit">{{ m.wrong }}</span></div>
      <div class="r"><span class="mk">✓</span><span class="fit">{{ m.right }}</span></div>
    </div>
    {% endfor %}
  </div>

{% elif n == 5 %}
  <div class="paper edge-both">
    {{ head("어디서 봤더라?") }}
    {% for e in post.menu.items %}
    <div class="ex">
      <div class="exname">{{ e.name }}</div>
      {% if e.dst %}
      <div class="rel"><span class="src">{{ e.src }}</span><span class="act"><em class="fit">{{ e.action }}</em><i></i></span><span class="dst">{{ e.dst }}</span></div>
      {% else %}
      <div class="solo"><span class="src">{{ e.src }}</span><span class="note fit">{{ e.action }}</span></div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

{% elif n == 6 %}
  <div class="paper edge-both">
    {{ head("어떻게 돌아가?") }}
    <div class="flow">
      {% for s in post.steps.steps %}
        {% if not loop.first %}<div class="arrow">↓</div>{% endif %}
        <div class="node n{{ s.who[0] }}"><span class="fit"><b>{{ loop.index }}</b>{{ s.text }}</span></div>
      {% endfor %}
    </div>
  </div>

{% elif n == 7 %}
  <div class="paper edge-both">
    {{ head("언제 알아야 해?") }}
    {% for s in post.options.situations %}<div class="bubble{{ ' r' if loop.index is even else '' }} fit">{{ s }}</div>{% endfor %}
  </div>

{% elif n == 8 %}
  {% set sp = post.special %}
  <div class="paper edge-both">
    {{ head("요즘 어디에 쓰여?") }}
    {% if sp.news %}
      {% for item in sp.news %}<div class="news"><div class="t fit">{{ item.title }}</div><div class="s">{{ item.source }}</div><div class="y fit">{{ item.why }}</div></div>{% endfor %}
    {% else %}
      <div class="fallback fit">{{ concepts(sp.fallback) }}</div>
    {% endif %}
  </div>

{% elif n == 9 %}
  <div class="paper edge-both caution">
    {{ head("이건 조심!") }}
    {% for w in post.caution.items %}<div class="warn"><span class="ic">{{ loop.index }}</span><div class="tx"><b class="fit">{{ w.title }}</b><span class="fit">{{ w.reason }}</span></div></div>{% endfor %}
  </div>

{% elif n == 10 %}
  {% set tt = post.total %}
  <div class="paper edge-top">
    {{ head("오늘 먹은 것") }}
    {% for p in tt.points %}<div class="line"><span class="label fit" style="overflow:hidden">{{ loop.index }} {{ p }}</span><i class="leader"></i><span class="value">✓</span></div>{% endfor %}
    {% if tt.next_topic %}<div class="hr"></div>
    <div class="total"><span>NEXT</span><span class="v fit">{{ tt.next_topic }}</span></div>{% endif %}
  </div>
  <div class="signoff">
    <div>
      <div class="big">오늘의 한입 소화 완료 <span class="heart">♥</span></div>
      <div class="small">필요할 때 다시 먹으러 와</div>
      <div class="handle">{{ handle }}</div>
    </div>
    {{ ending_svg }}
  </div>
{% endif %}

</div>
{% if pose %}<div class="filler">{{ pose }}</div>{% endif %}
{% endif %}
</body>
</html>
